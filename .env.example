# ---------------------------------------------------------------------------
# Copy to ".env.local" for local dev. In Vercel, add these under
# Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Admin login — pick a strong password and a long random secret.
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string

# Database connection string (Vercel → Storage → create a Neon Postgres DB).
# Vercel injects this automatically once the database is linked to the project.
DATABASE_URL=

# Vercel Blob token for image uploads (Vercel → Storage → create a Blob store).
# Injected automatically once the Blob store is linked.
BLOB_READ_WRITE_TOKEN=

# Public URL of the live site (used for SEO canonical links & sitemap).
NEXT_PUBLIC_SITE_URL=https://oliviyadevelopers.com
